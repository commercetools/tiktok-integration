# Copy to .env.local for local development (mc-scripts start). Real values come from Connect in production.
ENABLE_NEW_JSX_TRANSFORM=true
FAST_REFRESH=true

# The Application URL of your local/deployed custom application
APPLICATION_URL=http://localhost:3001
# Project key used by `mc-scripts start`
INITIAL_PROJECT_KEY=your-project-key

# Values of the custom application registered in Merchant Center
CUSTOM_APPLICATION_ID=your-custom-application-id
ENTRY_POINT_URI_PATH=tiktok-connect
CLOUD_IDENTIFIER=gcp-eu
# Service URL (ending in /service); leave empty to see the "service not configured" screen
SERVICE_URL=
