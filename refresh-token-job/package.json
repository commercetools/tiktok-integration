{
  "name": "@commercetools-labs/tiktok-integration-refresh-token-job",
  "description": "Scheduled job: refreshes the TikTok tokens and reconciles orders missed by webhooks",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "gcp-build": "yarn --cwd ../shared install && yarn --cwd ../shared run build && tsc",
    "start": "node build/src/index.js",
    "start:dev": "concurrently -k \"tsc --watch\" \"nodemon -q build/src/index.js\"",
    "build": "yarn --cwd ../shared install && yarn --cwd ../shared run build && rimraf ./build && tsc",
    "lint": "eslint . --ext .ts",
    "test": "yarn run build && jest",
    "prettier": "prettier --write '**/*.{js,ts}'"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@commercetools-backend/express": "^27.15.0",
    "@commercetools-backend/loggers": "^27.15.0",
    "@commercetools/platform-sdk": "^8.0.0",
    "@commercetools/ts-client": "^4.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "request": "^2.88.2",
    "tiktok-shared": "link:../shared",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.3",
    "@types/express": "^4.17.14",
    "@types/jest": "^29.2.1",
    "@types/node": "^22.0.0",
    "@types/request": "^2.48.13",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^5.43.0",
    "@typescript-eslint/parser": "^5.43.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.46.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6"
  },
  "resolutions": {
    "form-data": "2.5.5",
    "glob": "11.1.0"
  },
  "packageManager": "yarn@1.22.22"
}
