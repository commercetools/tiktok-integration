{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "build",
    "**/*.spec.ts",
    "src/test"
  ],
  "compilerOptions": {
    "resolveJsonModule": true,
    "outDir": "./build",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "*": [
        "./node_modules/*",
        "./node_modules/@types/*"
      ]
    },
    "inlineSourceMap": true
  }
}
