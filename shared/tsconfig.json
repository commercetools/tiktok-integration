{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "include": ["."],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/__snapshots__",
    "tiktok-sdk/**/*.md"
  ],
  "compilerOptions": {
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": { "*": ["./node_modules/*", "./node_modules/@types/*"] },
    "inlineSourceMap": true
  }
}
